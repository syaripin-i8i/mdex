{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/syaripin-i8i/mdex/schemas/impact.schema.json",
  "title": "mdex impact output",
  "description": "Contract for mdex impact JSON output",
  "type": "object",
  "required": [
    "contract_schema",
    "contract_version",
    "inputs",
    "read_first",
    "related_tasks",
    "decision_records",
    "stale_watch"
  ],
  "properties": {
    "contract_schema": {
      "type": "string",
      "description": "Schema URL identifying this output contract."
    },
    "contract_version": {
      "type": "string",
      "description": "mdex contract version for this payload."
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inputItem"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warningItem"
      }
    },
    "read_first": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/impactItem"
      }
    },
    "related_tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/impactItem"
      }
    },
    "decision_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/impactItem"
      }
    },
    "stale_watch": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/impactItem"
      }
    },
    "unusual_neighbors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/impactItem"
      }
    },
    "isolated_changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/impactItem"
      }
    },
    "missing_decision_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/impactItem"
      }
    },
    "unreflected_specs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/impactItem"
      }
    }
  },
  "$defs": {
    "inputItem": {
      "type": "object",
      "required": [
        "path",
        "exists",
        "indexed"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        },
        "indexed": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "warningItem": {
      "type": "object",
      "required": [
        "code",
        "path",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "impactItem": {
      "type": "object",
      "required": [
        "id",
        "reason",
        "score"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "reason_code": {
          "type": "string"
        },
        "score_breakdown": {
          "type": "object",
          "required": ["total"],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
