{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/syaripin-i8i/mdex/schemas/context.schema.json",
  "title": "mdex context output",
  "description": "Contract for mdex context JSON output",
  "type": "object",
  "required": [
    "contract_schema",
    "contract_version",
    "query",
    "health",
    "nodes",
    "total_tokens",
    "budget"
  ],
  "properties": {
    "contract_schema": {
      "type": "string",
      "description": "Schema URL identifying this output contract."
    },
    "contract_version": {
      "type": "string",
      "description": "mdex contract version for this payload."
    },
    "query": {
      "type": "string"
    },
    "health": { "$ref": "https://github.com/syaripin-i8i/mdex/schemas/health.schema.json" },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contextNode"
      }
    },
    "total_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "budget": {
      "type": "integer",
      "minimum": 1
    },
    "recommended_read_order": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/readOrderItem"
      }
    },
    "recommended_next_actions": {
      "type": "array",
      "deprecated": true,
      "description": "Deprecated v1 string actions kept for 0.2.x compatibility. Agents should prefer recommended_next_actions_v2 to avoid parsing command strings.",
      "items": {
        "type": "string"
      }
    },
    "recommended_next_actions_v2": {
      "type": "array",
      "description": "Preferred structured actions for agents. Execute command and args as argv, not as a shell string.",
      "items": {
        "$ref": "#/$defs/actionV2Item"
      }
    },
    "deferred_nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deferredItem"
      }
    },
    "discovery_candidates": {
      "type": "array",
      "description": "Low-cost side-read candidates that are not part of the primary read order.",
      "items": {
        "$ref": "#/$defs/discoveryCandidate"
      }
    },
    "budget_dropped_nodes": {
      "type": "array",
      "description": "High-scoring candidates omitted because the context soft budget would be exceeded.",
      "items": {
        "$ref": "#/$defs/budgetDroppedNode"
      }
    },
    "multi_index": {
      "type": "object",
      "description": "Present when context was merged from multiple index databases. Each indexes.* entry carries a source label (config:<alias>/default:<alias>, suffixed with +worktree_common_root for a db borrowed read-only from a linked worktree's main checkout; borrowed entries also set borrowed and local_path).",
      "additionalProperties": true
    },
    "per_index_context": {
      "type": "object",
      "description": "Per-index raw context payloads keyed by index alias.",
      "additionalProperties": true
    },
    "confidence": {
      "type": "number"
    },
    "zero_hits": {
      "$ref": "#/$defs/zeroHits"
    },
    "why_this_set": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actionable_digest": {
      "$ref": "#/$defs/actionableDigest"
    },
    "agent_prompt_pack": {
      "$ref": "#/$defs/agentPromptPack"
    },
    "evidence_identity": {
      "$ref": "#/$defs/evidenceIdentity"
    }
  },
  "$defs": {
    "evidenceIdentity": {
      "type": "object",
      "required": ["status", "reusable", "reason"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["verified", "identified", "unavailable"]
        },
        "reusable": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "scan_id": {
          "type": "string"
        },
        "config_hash": {
          "type": "string"
        },
        "index_kind": {
          "type": "string"
        },
        "source_state": {
          "$ref": "#/$defs/sourceState"
        }
      },
      "additionalProperties": false
    },
    "sourceState": {
      "type": "object",
      "required": ["status", "reason", "scan_id", "config_hash"],
      "properties": {
        "status": {"type": "string", "enum": ["fresh", "stale", "unknown"]},
        "reason": {"type": "string"},
        "scan_id": {"type": "string"},
        "config_hash": {"type": "string"},
        "current_config_hash": {"type": "string"},
        "stored_fingerprint_hash": {"type": "string"},
        "current_fingerprint_hash": {"type": "string"},
        "detail": {"type": "string"}
      },
      "additionalProperties": false
    },
    "agentPromptPack": {
      "type": "object",
      "required": ["role", "query", "instructions", "required_reads", "prompt"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["worker", "reviewer", "commander"]
        },
        "query": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "required_reads": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "discovery_candidates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "prompt": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "actionableDigest": {
      "type": "object",
      "required": [
        "intent",
        "relevant_docs",
        "suggested_rg",
        "context_gaps"
      ],
      "properties": {
        "intent": {
          "type": "string"
        },
        "relevant_docs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digestNode"
          }
        },
        "relevant_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digestNode"
          }
        },
        "relevant_task_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digestNode"
          }
        },
        "likely_code_entrypoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digestNode"
          }
        },
        "known_guardrails": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digestNode"
          }
        },
        "discovery_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/discoveryCandidate"
          }
        },
        "suggested_rg": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rgSuggestion"
          }
        },
        "context_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "digestNode": {
      "type": "object",
      "required": [
        "id",
        "title",
        "type",
        "status",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "rgSuggestion": {
      "type": "object",
      "required": [
        "command",
        "args",
        "pattern",
        "paths",
        "reason"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pattern": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "readOrderItem": {
      "type": "object",
      "required": [
        "id",
        "title",
        "priority",
        "source",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "deferredItem": {
      "type": "object",
      "required": [
        "id",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "discoveryCandidate": {
      "type": "object",
      "required": [
        "id",
        "reason",
        "reason_code",
        "score",
        "score_breakdown"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "shared_dependencies",
            "shared_links",
            "stale_but_related",
            "orphan_nearby",
            "recently_updated_neighbor",
            "same_type_same_project"
          ]
        },
        "score": {
          "type": "number"
        },
        "score_breakdown": {
          "type": "object",
          "required": ["total"],
          "additionalProperties": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "budgetDroppedNode": {
      "type": "object",
      "required": ["id", "score", "budget_drop_reason"],
      "properties": {
        "id": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "budget_drop_reason": {
          "type": "string"
        },
        "projected_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "soft_cap": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "actionV2Item": {
      "type": "object",
      "required": [
        "command",
        "args",
        "reason"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "zeroHits": {
      "type": "object",
      "description": "Present only when the query was searched and matched nothing. States which lanes bounded the zero and what would widen it; zero hits is not evidence that the document does not exist. Field names are shared protocol vocabulary with cdex.",
      "required": [
        "lanes_searched",
        "lanes_inactive",
        "caveat",
        "remediation"
      ],
      "properties": {
        "lanes_searched": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lanes_inactive": {
          "type": "object",
          "description": "Always present. Lane name to the reason it was not searched (e.g. body_text: documented_non_goal); an empty object means every known lane was searched. Reason tokens are an open set — consumers must not reject unknown tokens.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "caveat": {
          "type": "string"
        },
        "remediation": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "contextNode": {
      "type": "object",
      "required": [
        "id",
        "priority",
        "score",
        "score_breakdown",
        "estimated_tokens"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "score": {
          "type": "number"
        },
        "score_breakdown": {
          "type": "object"
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "content": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
