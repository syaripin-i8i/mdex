{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/syaripin-i8i/mdex/schemas/status.schema.json",
  "title": "mdex status output",
  "description": "Contract for mdex status JSON output",
  "type": "object",
  "required": [
    "contract_schema",
    "contract_version",
    "status",
    "summary",
    "checks",
    "indexes",
    "recommended_next_actions"
  ],
  "properties": {
    "contract_schema": {
      "type": "string"
    },
    "contract_version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["ok", "warning", "error"]
    },
    "summary": {
      "type": "object",
      "required": ["error", "warning", "info"],
      "additionalProperties": true
    },
    "checks": {
      "type": "array"
    },
    "indexes": {
      "type": "object",
      "additionalProperties": true
    },
    "recommended_next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
